<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cadence.rem-plan</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CADENCE_BIN__</string>
		<string>rem</string>
		<string>plan</string>
		<string>--prefix</string>
		<string>__PREFIX__</string>
		<string>--countdown</string>
		<string>__COUNTDOWN__</string>
		<string>--list</string>
		<string>__LIST__</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/cadence-rem-plan/launchd.log</string>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/cadence-rem-plan/launchd.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>0</integer>
		<key>Weekday</key>
		<integer>5</integer>
	</dict>
</dict>
</plist>
